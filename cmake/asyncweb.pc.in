prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: asyncweb
Description: Async HTTP/HTTPS/WebSocket library (built on libcoro)
Version: 1.0.0
Requires: @ASYNCWEB_PC_REQUIRES@
Libs: -L${libdir} -lasyncweb
Cflags: -I${includedir}
